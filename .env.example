PORT=5340
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/school_db?schema=public
JWT_SECRET_KEY=your-secret-key

# Frontend URL (SSO redirect, Paystack callback)
FRONTEND_URL=http://localhost:5345

# Paystack (Module 8) — omit for demo checkout
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# PAYSTACK_CALLBACK_URL=http://localhost:5345/paystack/callback

# Google SSO (Module 0)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5340/api/v1/auth/google/callback

# Microsoft Entra ID SSO
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:5340/api/v1/auth/microsoft/callback
# MICROSOFT_TENANT_ID=common

# AWS S3 (optional — mirrors uploads/ when set)
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_PUBLIC_BASE_URL=

# IoT access webhook (POST /api/v1/access/webhook, header X-IoT-Key)
# IOT_WEBHOOK_SECRET=

# Termii SMS / WhatsApp (notification worker)
# TERMII_API_KEY=
# TERMII_SENDER_ID=SchoolPortal

# SMTP (notification worker — EMAIL channel)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@school.local
