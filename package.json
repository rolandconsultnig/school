{
  "name": "school-management-system",
  "version": "1.0.0",
  "description": "School management system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "nodemon server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "worker:notifications": "node workers/notificationWorker.js",
    "dev:web": "npm run dev --prefix web",
    "build:web": "npm ci --prefix web && npm run build --prefix web",
    "test": "node --test tests/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "github.com/iamtonmoy0/school-management-system"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "morgan": "^1.10.0",
    "nodemon": "^3.0.1",
    "prisma": "^5.22.0"
  }
}
