generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicTerms AdminAcademicTerm[]
  programs      AdminProgram[]
  yearGroups    AdminYearGroup[]
  academicYears AdminAcademicYear[]
  classLevels   AdminClassLevel[]
  teachers      AdminTeacher[]
  students      AdminStudent[]

  createdAcademicTerms AcademicTerm[] @relation("AcademicTermCreatedBy")
  createdAcademicYears AcademicYear[] @relation("AcademicYearCreatedBy")
  createdClassLevels   ClassLevel[]   @relation("ClassLevelCreatedBy")
  createdPrograms      Program[]      @relation("ProgramCreatedBy")
  createdSubjects      Subject[]      @relation("SubjectCreatedBy")
  createdYearGroups    YearGroup[]    @relation("YearGroupCreatedBy")
  createdTeachers      Teacher[]      @relation("TeacherCreatedBy")
}

model Teacher {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  password          String
  dateEmployed      DateTime @default(now())
  teacherId         String   @unique
  isWithdrawn       Boolean  @default(false)
  isSuspended       Boolean  @default(false)
  role              String   @default("teacher")
  applicationStatus String   @default("pending")
  program           String?
  classLevel        String?
  academicYear      String?
  academicTerm      String?
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy     Admin                 @relation("TeacherCreatedBy", fields: [createdById], references: [id])
  subjects      Subject[]             @relation("SubjectTeacher")
  admins        AdminTeacher[]
  programs      ProgramTeacher[]
  classLevels   ClassLevelTeacher[]
  academicYears AcademicYearTeacher[]
  examsCreated  TeacherExam[]
  exams         Exam[]                @relation("ExamCreator")
  questions     Question[]
  examResults   ExamResult[]
  ptaMessages      PtaMessage[]
  timetableSlots   TimetableSlot[]
  substitutions    TimetableSubstitution[] @relation("SubstituteTeacher")
  courses          Course[]
  leaveRequests    LeaveRequest[]
  studentMessages  StudentMessage[]
  payrollLines        PayrollLine[]
  performanceReviews  PerformanceReview[]

  @@index([email])
}

model Student {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  password       String
  studentId      String    @unique
  role           String    @default("student")
  academicYearId String?
  programId      String?
  campusId       String?
  tier           SchoolTier?
  gradeLevelId   String?
  section        String?
  dateAdmitted   DateTime  @default(now())
  isGraduated    Boolean   @default(false)
  isWithdrawn    Boolean   @default(false)
  isSuspended    Boolean   @default(false)
  prefectName    String?
  yearGraduated  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campus       Campus?       @relation(fields: [campusId], references: [id])
  gradeLevel   GradeLevel?   @relation(fields: [gradeLevelId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  program      Program?      @relation(fields: [programId], references: [id])
  admins       AdminStudent[]
  classLevels  StudentClassLevel[]
  academicYears AcademicYearStudent[]
  programs     ProgramStudent[]
  examResults  StudentExamResult[]
  results      ExamResult[]
  health       StudentHealth?
  emergencyContacts EmergencyContact[]
  documents    StudentDocument[]
  applicantRecord Applicant?
  parents       ParentStudent[]
  ptaMessages   PtaMessage[]
  promotions         PromotionRecord[]
  attendanceRecords  AttendanceRecord[]
  doorEntries         AttendanceDoorEntry[]
  courseEnrollments   CourseEnrollment[]
  assignmentSubmissions AssignmentSubmission[]
  studentFees           StudentFee[]
  libraryLoans          LibraryLoan[]
  idCards               StudentIdCard[]
  accessScans           AccessScan[]
  reportCards           ReportCard[]
  documentRequests      StudentDocumentRequest[]
  feedback              StudentFeedback[]
  messages              StudentMessage[]
  campusWallet          StudentCampusWallet?
  walletTransactions    WalletTransaction[]

  @@index([email])
}

model AcademicTerm {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  duration    String   @default("3 months")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy Admin             @relation("AcademicTermCreatedBy", fields: [createdById], references: [id])
  admins    AdminAcademicTerm[]
  subjects           Subject[]
  exams              Exam[]
  results            ExamResult[]
  timetableSlots     TimetableSlot[]
  attendanceSessions AttendanceSession[]
  courses            Course[]
}

model AcademicYear {
  id         String   @id @default(uuid())
  name       String   @unique
  fromYear   DateTime
  toYear     DateTime
  isCurrent  Boolean  @default(false)
  createdById String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  createdBy   Admin               @relation("AcademicYearCreatedBy", fields: [createdById], references: [id])
  admins      AdminAcademicYear[]
  students    AcademicYearStudent[]
  teachers    AcademicYearTeacher[]
  yearGroups  YearGroup[]
  studentsDirect Student[]
  exams       Exam[]
  results     ExamResult[]
}

model ClassLevel {
  id           String      @id @default(uuid())
  name         String
  description  String?
  createdById  String
  campusId     String?
  tier         SchoolTier?
  gradeLevelId String?
  section      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  campus     Campus?     @relation(fields: [campusId], references: [id])
  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id])
  createdBy  Admin       @relation("ClassLevelCreatedBy", fields: [createdById], references: [id])
  admins    AdminClassLevel[]
  students  StudentClassLevel[]
  subjects  ClassLevelSubject[]
  teachers  ClassLevelTeacher[]
  exams     Exam[]
  results   ExamResult[]
  timetableSlots     TimetableSlot[]
  attendanceSessions AttendanceSession[]
  courses            Course[]

  @@unique([name, campusId])
}

model Program {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  duration    String   @default("4 years")
  code        String   @unique
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy Admin            @relation("ProgramCreatedBy", fields: [createdById], references: [id])
  admins    AdminProgram[]
  teachers  ProgramTeacher[]
  students  ProgramStudent[]
  subjects  ProgramSubject[]
  studentsDirect Student[]
  exams     Exam[]
  applicants Applicant[]
}

model Subject {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String
  teacherId      String?
  academicTermId String
  createdById    String
  duration       String   @default("3 months")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teacher      Teacher?     @relation("SubjectTeacher", fields: [teacherId], references: [id])
  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id])
  createdBy    Admin        @relation("SubjectCreatedBy", fields: [createdById], references: [id])
  programs     ProgramSubject[]
  classLevels  ClassLevelSubject[]
  exams          Exam[]
  results        ExamResult[]
  timetableSlots TimetableSlot[]
  courses        Course[]
}

model YearGroup {
  id             String   @id @default(uuid())
  name           String
  createdById    String
  academicYearId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy    Admin        @relation("YearGroupCreatedBy", fields: [createdById], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  admins       AdminYearGroup[]

  @@unique([name, academicYearId])
}

model Exam {
  id             String   @id @default(uuid())
  name           String
  description    String
  subjectId      String
  programId      String
  passMark       Int      @default(50)
  totalMark      Int      @default(100)
  duration       String   @default("30 minutes")
  examDate       DateTime @default(now())
  examTime       String
  examType       String   @default("Quiz")
  examStatus     String   @default("pending")
  classLevelId   String?
  createdById    String
  academicTermId String
  academicYearId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subject      Subject      @relation(fields: [subjectId], references: [id])
  program      Program      @relation(fields: [programId], references: [id])
  classLevel   ClassLevel?   @relation(fields: [classLevelId], references: [id])
  createdBy    Teacher       @relation("ExamCreator", fields: [createdById], references: [id])
  academicTerm AcademicTerm  @relation(fields: [academicTermId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  teachers     TeacherExam[]
  questions    ExamQuestion[]
  results      ExamResult[]

  @@index([name])
}

model Question {
  id            String   @id @default(uuid())
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  isCorrect     Boolean  @default(false)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy Teacher       @relation(fields: [createdById], references: [id])
  exams     ExamQuestion[]
}

model ExamResult {
  id                String   @id @default(uuid())
  studentId         String
  examId            String
  grade             Float
  score             Int
  passMark          Int      @default(50)
  answeredQuestions Json     @default("[]")
  status            String   @default("failed")
  remarks           String   @default("Poor")
  position          Int?
  teacherId         String
  subjectId         String?
  classLevelId      String?
  academicTermId    String
  academicYearId    String
  isPublished       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  exam         Exam         @relation(fields: [examId], references: [id])
  teacher      Teacher      @relation(fields: [teacherId], references: [id])
  subject      Subject?     @relation(fields: [subjectId], references: [id])
  classLevel   ClassLevel?  @relation(fields: [classLevelId], references: [id])
  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  students     StudentExamResult[]
}

// Junction tables (formerly MongoDB embedded arrays)

model AdminAcademicTerm {
  adminId        String
  academicTermId String
  admin          Admin        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)

  @@id([adminId, academicTermId])
}

model AdminProgram {
  adminId   String
  programId String
  admin     Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([adminId, programId])
}

model AdminYearGroup {
  adminId     String
  yearGroupId String
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  yearGroup   YearGroup @relation(fields: [yearGroupId], references: [id], onDelete: Cascade)

  @@id([adminId, yearGroupId])
}

model AdminAcademicYear {
  adminId        String
  academicYearId String
  admin          Admin        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@id([adminId, academicYearId])
}

model AdminClassLevel {
  adminId      String
  classLevelId String
  admin        Admin      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  @@id([adminId, classLevelId])
}

model AdminTeacher {
  adminId   String
  teacherId String
  admin     Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([adminId, teacherId])
}

model AdminStudent {
  adminId   String
  studentId String
  admin     Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([adminId, studentId])
}

model ProgramTeacher {
  programId String
  teacherId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([programId, teacherId])
}

model ProgramStudent {
  programId String
  studentId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([programId, studentId])
}

model ProgramSubject {
  programId String
  subjectId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([programId, subjectId])
}

model ClassLevelSubject {
  classLevelId String
  subjectId    String
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([classLevelId, subjectId])
}

model ClassLevelTeacher {
  classLevelId String
  teacherId    String
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  teacher      Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([classLevelId, teacherId])
}

model AcademicYearStudent {
  academicYearId String
  studentId      String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([academicYearId, studentId])
}

model AcademicYearTeacher {
  academicYearId String
  teacherId      String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([academicYearId, teacherId])
}

model StudentClassLevel {
  studentId    String
  classLevelId String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  @@id([studentId, classLevelId])
}

model StudentExamResult {
  studentId    String
  examResultId String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examResult   ExamResult @relation(fields: [examResultId], references: [id], onDelete: Cascade)

  @@id([studentId, examResultId])
}

model TeacherExam {
  teacherId String
  examId    String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@id([teacherId, examId])
}

model ExamQuestion {
  examId     String
  questionId String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([examId, questionId])
}

// ─── Module 0: Foundation (Nigeria tiers, multi-tenant, RBAC, audit) ───

enum SchoolTier {
  NURSERY
  PRIMARY
  SECONDARY
}

enum ProfileType {
  ADMIN
  TEACHER
  STUDENT
  STAFF
  PARENT
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ACCESS_GRANTED
  ACCESS_DENIED
  PUBLISH
  ENROLL
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  country   String   @default("NG")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campuses     Campus[]
  userAccounts UserAccount[]
  auditLogs    AuditLog[]
}

model Campus {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  isActive       Boolean  @default(true)
  accessLockdown Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tiers        CampusTier[]
  gradeLevels  GradeLevel[]
  userRoles    UserRoleAssignment[]
  auditLogs    AuditLog[]
  students     Student[]
  classLevels  ClassLevel[]
  notifications NotificationQueue[]
  inquiries    AdmissionInquiry[]
  applicants   Applicant[]
  parents      Parent[]
  timetableSlots     TimetableSlot[]
  attendanceSessions AttendanceSession[]
  doorImports        AttendanceDoorImport[]
  courses            Course[]
  feeStructures      FeeStructure[]
  libraryBooks       LibraryBook[]
  idCardTemplates    IdCardTemplate[]
  accessRules        AccessRule[]
  transportRoutes    TransportRoute[]
  cafeteriaMenus     CafeteriaMenu[]
  announcements      CampusAnnouncement[]
  payrollRuns        PayrollRun[]
  ptaMeetings        PtaMeeting[]
  ptaPolls           PtaPoll[]

  @@unique([organizationId, code])
}

model CampusTier {
  campusId String
  tier     SchoolTier
  campus   Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@id([campusId, tier])
}

/// Nigerian grade catalog (Nursery 1, Primary 3, JSS 2, etc.)
model GradeLevel {
  id            String     @id @default(uuid())
  tier          SchoolTier
  name          String
  code          String     @unique
  sortOrder     Int
  nigerianLabel String?
  campusId      String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  campus      Campus?      @relation(fields: [campusId], references: [id])
  classLevels ClassLevel[]
  students    Student[]
  applicants  Applicant[]

  @@index([tier, sortOrder])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      Int
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserAccount {
  id             String      @id @default(uuid())
  email          String      @unique
  password       String?
  profileType    ProfileType
  profileId      String
  organizationId String?
  isActive       Boolean     @default(true)
  googleId       String?     @unique
  microsoftId    String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization?        @relation(fields: [organizationId], references: [id])
  roleAssignments UserRoleAssignment[]
  auditLogs       AuditLog[]           @relation("AuditActor")

  @@index([profileType, profileId])
}

model UserRoleAssignment {
  id            String      @id @default(uuid())
  userAccountId String?
  legacyProfileType ProfileType?
  legacyProfileId   String?
  roleId        String
  campusId      String?
  tier          SchoolTier?
  createdAt     DateTime    @default(now())

  userAccount UserAccount? @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  role        Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  campus      Campus?      @relation(fields: [campusId], references: [id])

  @@index([legacyProfileType, legacyProfileId])
  @@index([userAccountId])
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  actorType  ProfileType?
  actorEmail String?
  action     AuditAction
  module     Int?
  entityType String
  entityId   String?
  campusId   String?
  tier       SchoolTier?
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor        UserAccount? @relation("AuditActor", fields: [actorId], references: [id])
  campus       Campus?      @relation(fields: [campusId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@index([entityType, entityId])
  @@index([campusId, createdAt])
  @@index([actorId, createdAt])
}

model NotificationQueue {
  id          String             @id @default(uuid())
  channel     NotificationChannel
  status      NotificationStatus @default(PENDING)
  recipient   String
  subject     String?
  body        String
  payload     Json?
  campusId    String?
  scheduledAt DateTime?
  sentAt      DateTime?
  error       String?
  createdAt   DateTime           @default(now())

  campus Campus? @relation(fields: [campusId], references: [id])

  @@index([status, scheduledAt])
}

// ─── Module 2: SIS extensions ───

enum StudentDocumentType {
  TRANSCRIPT
  BIRTH_CERTIFICATE
  MEDICAL
  BEHAVIOR_WARNING
  CERTIFICATE
  OTHER
}

model StudentHealth {
  studentId          String  @id
  bloodGroup         String?
  allergies          String?
  medicalConditions  String?
  medications        String?
  doctorName         String?
  doctorPhone        String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id           String   @id @default(uuid())
  studentId    String
  name         String
  relationship String
  phone        String
  email        String?
  address      String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model StudentDocument {
  id           String              @id @default(uuid())
  studentId    String
  title        String
  documentType StudentDocumentType @default(OTHER)
  fileUrl      String
  description  String?
  issuedAt     DateTime?
  uploadedById String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ─── Module 1: Admissions ───

enum ApplicantStatus {
  INQUIRY
  APPLIED
  DOCUMENT_REVIEW
  INTERVIEW_SCHEDULED
  INTERVIEWED
  ACCEPTED
  REJECTED
  ENROLLED
  WITHDRAWN
}

enum DocumentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model AdmissionInquiry {
  id           String        @id @default(uuid())
  campusId     String?
  tier         SchoolTier?
  parentName   String
  parentEmail  String
  parentPhone  String
  studentName  String
  message      String?
  status       InquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  campus   Campus?    @relation(fields: [campusId], references: [id])
  applicant Applicant?

  @@index([status])
  @@index([parentEmail])
}

model Applicant {
  id                 String          @id @default(uuid())
  inquiryId          String?         @unique
  email              String          @unique
  password           String?
  firstName          String
  lastName           String
  dateOfBirth        DateTime?
  gender             String?
  tier               SchoolTier
  campusId           String?
  gradeLevelId       String?
  programId          String?
  status             ApplicantStatus @default(APPLIED)
  applicationFeePaid Boolean         @default(false)
  interviewDate      DateTime?
  interviewScore     Float?
  interviewNotes     String?
  reviewerNotes      String?
  enrolledStudentId  String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  inquiry         AdmissionInquiry? @relation(fields: [inquiryId], references: [id])
  campus          Campus?           @relation(fields: [campusId], references: [id])
  gradeLevel      GradeLevel?       @relation(fields: [gradeLevelId], references: [id])
  program         Program?          @relation(fields: [programId], references: [id])
  enrolledStudent Student?          @relation(fields: [enrolledStudentId], references: [id])
  documents       ApplicantDocument[]

  @@index([status])
  @@index([campusId, tier])
}

model ApplicantDocument {
  id                 String                     @id @default(uuid())
  applicantId        String
  title              String
  fileUrl            String
  documentType       String                     @default("OTHER")
  verificationStatus DocumentVerificationStatus @default(PENDING)
  reviewComments     String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
}

// ─── Module 10: PTA / Parents ───

model Parent {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      String   @default("parent")
  campusId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus       Campus?            @relation(fields: [campusId], references: [id])
  children     ParentStudent[]
  messages     PtaMessage[]
  meetingRsvps PtaMeetingRsvp[]
  pollVotes    PtaPollVote[]

  @@index([email])
}

model ParentStudent {
  parentId     String
  studentId    String
  relationship String  @default("Guardian")
  isPrimary    Boolean @default(false)
  createdAt    DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
}

model PtaMessage {
  id        String   @id @default(uuid())
  parentId  String
  teacherId String
  studentId String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([parentId, createdAt])
  @@index([teacherId, createdAt])
}

model PtaMeeting {
  id          String   @id @default(uuid())
  campusId    String?
  title       String
  body        String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime @default(now())

  campus Campus?           @relation(fields: [campusId], references: [id])
  rsvps  PtaMeetingRsvp[]

  @@index([campusId, startsAt])
}

model PtaMeetingRsvp {
  meetingId String
  parentId  String
  status    String   @default("GOING")
  createdAt DateTime @default(now())

  meeting PtaMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  parent  Parent     @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([meetingId, parentId])
}

model PtaPoll {
  id        String    @id @default(uuid())
  campusId  String?
  question  String
  closesAt  DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  campus  Campus?         @relation(fields: [campusId], references: [id])
  options PtaPollOption[]
  votes   PtaPollVote[]

  @@index([campusId, isActive])
}

model PtaPollOption {
  id     String @id @default(uuid())
  pollId String
  label  String

  poll  PtaPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PtaPollVote[]

  @@index([pollId])
}

model PtaPollVote {
  pollId   String
  parentId String
  optionId String

  poll   PtaPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  parent Parent        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  option PtaPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([pollId, parentId])
}

// ─── SIS: Promotion history ───

model PromotionRecord {
  id               String   @id @default(uuid())
  studentId        String
  fromGradeLevelId String?
  toGradeLevelId   String?
  promoted         Boolean  @default(true)
  academicYearId   String?
  notes            String?
  promotedById     String?
  createdAt        DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

// ─── Module 5: Attendance & Scheduling ───

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model TimetableSlot {
  id             String      @id @default(uuid())
  campusId       String?
  tier           SchoolTier?
  classLevelId   String
  subjectId      String?
  teacherId      String
  dayOfWeek      Int
  startMinutes   Int
  endMinutes     Int
  room           String?
  academicTermId String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  campus       Campus?       @relation(fields: [campusId], references: [id])
  classLevel   ClassLevel    @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  subject      Subject?      @relation(fields: [subjectId], references: [id])
  teacher      Teacher       @relation(fields: [teacherId], references: [id])
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id])
  substitutions TimetableSubstitution[]

  @@index([classLevelId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([campusId, tier])
}

model TimetableSubstitution {
  id                  String   @id @default(uuid())
  timetableSlotId     String
  substituteTeacherId String
  effectiveDate       DateTime @db.Date
  reason              String?
  createdById         String?
  createdAt           DateTime @default(now())

  slot              TimetableSlot @relation(fields: [timetableSlotId], references: [id], onDelete: Cascade)
  substituteTeacher Teacher       @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])

  @@unique([timetableSlotId, effectiveDate])
}

model AttendanceSession {
  id             String      @id @default(uuid())
  classLevelId   String
  campusId       String?
  tier           SchoolTier?
  sessionDate    DateTime    @db.Date
  takenById      String
  academicTermId String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  classLevel   ClassLevel    @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  campus       Campus?       @relation(fields: [campusId], references: [id])
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id])
  records      AttendanceRecord[]

  @@unique([classLevelId, sessionDate])
  @@index([sessionDate])
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  remark    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model AttendanceDoorImport {
  id          String   @id @default(uuid())
  campusId    String?
  source      String   @default("door_scanner")
  fileName    String?
  rowCount    Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  campus  Campus?               @relation(fields: [campusId], references: [id])
  entries AttendanceDoorEntry[]
}

model AttendanceDoorEntry {
  id         String   @id @default(uuid())
  importId   String
  studentId  String?
  externalId String?
  scannedAt  DateTime
  gate       String?
  matched    Boolean  @default(false)

  import  AttendanceDoorImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  student Student?             @relation(fields: [studentId], references: [id])

  @@index([importId])
  @@index([scannedAt])
}

// ─── Module 6: LMS (courses, assignments, live classes, gradebook) ───

enum AssignmentType {
  HOMEWORK
  PROJECT
  QUIZ
  LAB
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  LATE
}

model Course {
  id             String      @id @default(uuid())
  title          String
  description    String?
  subjectId      String
  classLevelId   String?
  teacherId      String
  campusId       String?
  tier           SchoolTier?
  academicTermId String
  isPublished    Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  subject      Subject      @relation(fields: [subjectId], references: [id])
  classLevel   ClassLevel?  @relation(fields: [classLevelId], references: [id])
  teacher      Teacher      @relation(fields: [teacherId], references: [id])
  campus       Campus?      @relation(fields: [campusId], references: [id])
  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id])
  enrollments  CourseEnrollment[]
  assignments  Assignment[]
  liveSessions LiveClassSession[]

  @@index([teacherId])
  @@index([classLevelId])
  @@index([campusId, tier])
}

model CourseEnrollment {
  courseId   String
  studentId  String
  enrolledAt DateTime @default(now())

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([courseId, studentId])
}

model Assignment {
  id          String         @id @default(uuid())
  courseId    String
  title       String
  description String?
  type        AssignmentType @default(HOMEWORK)
  maxScore    Int            @default(100)
  dueAt       DateTime?
  isPublished Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([courseId])
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  contentUrl   String?
  contentText  String?
  score        Float?
  feedback     String?
  status       SubmissionStatus @default(DRAFT)
  submittedAt  DateTime?
  gradedAt     DateTime?
  gradedById   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model LiveClassSession {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  meetingUrl  String
  scheduledAt DateTime
  durationMin Int      @default(60)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, scheduledAt])
}

// ─── Module 9: HR ───

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(uuid())
  teacherId    String
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  reason       String
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, status])
}

// ─── Module 8: Finance ───

enum FeePaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

model FeeStructure {
  id             String      @id @default(uuid())
  name           String
  description    String?
  amount         Float
  currency       String      @default("NGN")
  tier           SchoolTier?
  campusId       String?
  academicTermId String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  campus   Campus?      @relation(fields: [campusId], references: [id])
  studentFees StudentFee[]

  @@index([campusId, tier])
}

model StudentFee {
  id             String           @id @default(uuid())
  studentId      String
  feeStructureId String
  amountDue      Float
  amountPaid     Float            @default(0)
  status         FeePaymentStatus @default(PENDING)
  dueDate        DateTime?        @db.Date
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments     FeePayment[]

  @@index([studentId, status])
}

enum PaymentProvider {
  PAYSTACK
  MANUAL
  CASH
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model FeePayment {
  id           String                   @id @default(uuid())
  studentFeeId String
  amount       Float
  provider     PaymentProvider          @default(PAYSTACK)
  reference    String                   @unique
  status       PaymentTransactionStatus @default(PENDING)
  metadata     Json?
  createdAt    DateTime                 @default(now())

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  @@index([studentFeeId])
}

// ─── Module 7: Library ───

model LibraryBook {
  id        String   @id @default(uuid())
  title     String
  author    String?
  isbn      String?
  copies    Int      @default(1)
  available Int      @default(1)
  campusId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus Campus?       @relation(fields: [campusId], references: [id])
  loans  LibraryLoan[]

  @@index([title])
}

model LibraryLoan {
  id         String    @id @default(uuid())
  bookId     String
  studentId  String
  borrowedAt DateTime  @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  fineAmount Float     @default(0)

  book    LibraryBook @relation(fields: [bookId], references: [id])
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ─── Module 3: ID Cards ───

model IdCardTemplate {
  id        String   @id @default(uuid())
  name      String
  layoutJson String  @default("{}")
  isDefault Boolean  @default(false)
  campusId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus Campus?         @relation(fields: [campusId], references: [id])
  cards  StudentIdCard[]
}

model StudentIdCard {
  id          String            @id @default(uuid())
  studentId   String
  templateId  String
  qrPayload   String
  printStatus IdCardPrintStatus @default(QUEUED)
  issuedAt    DateTime          @default(now())
  printedAt   DateTime?

  student  Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template IdCardTemplate @relation(fields: [templateId], references: [id])

  @@index([studentId])
  @@index([printStatus])
}

enum IdCardPrintStatus {
  QUEUED
  PRINTED
}

// ─── Module 4: IoT Access ───

model AccessRule {
  id          String   @id @default(uuid())
  name        String
  campusId    String?
  gate        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campus Campus?      @relation(fields: [campusId], references: [id])
  scans  AccessScan[]
}

model AccessScan {
  id         String   @id @default(uuid())
  ruleId     String?
  studentId  String?
  externalId String?
  gate       String
  granted    Boolean  @default(true)
  scannedAt  DateTime @default(now())

  rule    AccessRule? @relation(fields: [ruleId], references: [id])
  student Student?    @relation(fields: [studentId], references: [id])

  @@index([scannedAt])
}

// ─── Module 11: Ancillary ───

model TransportRoute {
  id           String    @id @default(uuid())
  name         String
  campusId     String?
  driverName   String?
  vehiclePlate String?
  stops        String?
  lastLatitude  Float?
  lastLongitude Float?
  lastGpsAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campus Campus? @relation(fields: [campusId], references: [id])
}

model CafeteriaMenu {
  id        String   @id @default(uuid())
  campusId  String?
  menuDate  DateTime @db.Date
  mealType  String
  items     String
  createdAt DateTime @default(now())

  campus Campus? @relation(fields: [campusId], references: [id])

  @@unique([campusId, menuDate, mealType])
}

// ─── Module 9: Payroll ───

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
}

model PayrollRun {
  id          String           @id @default(uuid())
  campusId    String?
  periodLabel String
  status      PayrollRunStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  campus Campus?       @relation(fields: [campusId], references: [id])
  lines  PayrollLine[]

  @@index([campusId, status])
}

model PayrollLine {
  id           String   @id @default(uuid())
  payrollRunId String
  teacherId    String
  baseSalary   Float
  deductions   Float    @default(0)
  netPay       Float
  createdAt    DateTime @default(now())

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  teacher    Teacher    @relation(fields: [teacherId], references: [id])

  @@index([payrollRunId])
}

model PerformanceReview {
  id           String   @id @default(uuid())
  teacherId    String
  periodLabel  String
  rating       Int?
  comments     String?
  status       String   @default("DRAFT")
  reviewedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
}

// ─── Module 12: Analytics / Report cards ───

model ReportCard {
  id             String   @id @default(uuid())
  studentId      String
  academicTermId String?
  summaryJson    String   @default("{}")
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ─── Student portal extras ───

enum DocumentRequestType {
  TRANSCRIPT
  ENROLLMENT_VERIFICATION
  CHARACTER_CERTIFICATE
}

enum DocumentRequestStatus {
  PENDING
  PROCESSING
  READY
  REJECTED
}

model CampusAnnouncement {
  id          String   @id @default(uuid())
  campusId    String?
  title       String
  body        String
  category    String   @default("GENERAL")
  isPinned    Boolean  @default(false)
  publishedAt DateTime @default(now())
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  campus Campus? @relation(fields: [campusId], references: [id])

  @@index([campusId, publishedAt])
}

model StudentDocumentRequest {
  id        String                @id @default(uuid())
  studentId String
  type      DocumentRequestType
  status    DocumentRequestStatus @default(PENDING)
  notes     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model StudentFeedback {
  id          String   @id @default(uuid())
  studentId   String?
  category    String
  body        String
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model StudentMessage {
  id        String   @id @default(uuid())
  studentId String
  teacherId String
  subject   String?
  body      String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([studentId])
}

model StudentCampusWallet {
  studentId String   @id
  balance   Float    @default(0)
  currency  String   @default("NGN")
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id          String   @id @default(uuid())
  studentId   String
  amount      Float
  description String
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}
