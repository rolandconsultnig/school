# Production API — copy to .env on the server (never commit .env)

NODE_ENV=production
PORT=5341

# Dedicated DB (do not reuse another app's database)
DATABASE_URL=postgresql://schoolportal_app:CHANGE_ME@127.0.0.1:5432/schoolportal_db?schema=public

JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING

# Public URL of the React app (SSO redirects, Paystack callback)
FRONTEND_URL=http://129.121.73.137/school

# OAuth callbacks (through nginx /school/api/ → Node)
# GOOGLE_REDIRECT_URI=http://129.121.73.137/school/api/v1/auth/google/callback
# MICROSOFT_REDIRECT_URI=http://129.121.73.137/school/api/v1/auth/microsoft/callback

# PAYSTACK_CALLBACK_URL=http://129.121.73.137/school/paystack/callback
