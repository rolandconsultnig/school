# Production build for https://129.121.73.137/school (or your domain)
# Copy to web/.env.production before: npm run build

# Subpath where the UI is served (must end with /)
VITE_BASE_PATH=/school/

# Public origin + subpath (no trailing slash). Proxied by nginx to the Node API.
VITE_API_URL=http://129.121.73.137/school

# If you add TLS later:
# VITE_API_URL=https://your-domain.com/school
